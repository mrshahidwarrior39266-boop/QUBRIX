# RubricGrader AI — optional local configuration
#
# Nothing in this file is required. The FastAPI dashboard grades entirely on this
# machine with local MiniLM embeddings and a deterministic rubric reasoner, so it
# works offline and never sends student answers to a third party.

# Optional: Google Gemini API key.
# Only the legacy Streamlit reasoning path reads this. Without a key, that path
# uses the local heuristic and the UI labels the active engine honestly.
GEMINI_API_KEY=

# The lexical TF-IDF fallback activates automatically if sentence-transformers or
# the MiniLM model cannot be loaded; no setting is required to demo it.
